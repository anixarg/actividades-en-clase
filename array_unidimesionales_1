using System;

class Program
{
    static int[] reverso(int[] arreglo)
    {
        int N = arreglo.Length;
        int[] invertido = new int[N];

        for (int i = 0; i < N; i++)
        {
            invertido[i] = arreglo[N - 1 - i];
        }

        return invertido;
    }

    static int productoEscalar(int[] a, int[] b)
    {
        int suma = 0;

        for (int i = 0; i < a.Length; i++)
        {
            suma = suma + a[i] * b[i];
        }

        return suma;
    }

    static int productoEscalarConInverso(int[] a, int[] b)
    {
        int[] bInvertido = reverso(b);

        return productoEscalar(a, bInvertido);
    }

    static void Main()
    {
        int[] a = { 1, 2, 3 };
        int[] b = { 4, 5, 6 };

        int resultado = productoEscalarConInverso(a, b);

        Console.WriteLine("Producto escalar con inverso es: " + resultado);
    }
}
